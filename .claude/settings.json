{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "enabledMcpjsonServers": ["Figma"],
  "permissions": {
    "allow": [
      "Bash(python3 .claude/orch.py *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(bunx tsc *)",
      "Bash(bunx playwright *)",
      "Bash(bunx biome *)",
      "Bash(bun run *)",
      "Bash(bun install*)",
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(git restore --staged *)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "Bash(git push*)",
      "Bash(git merge origin/*)",
      "Bash(git worktree *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Agent(fork)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(rm -rf *)",
      "Bash(docker push*)",
      "mcp__Figma__use_figma",
      "mcp__Figma__upload_assets",
      "mcp__plugin_figma_figma__use_figma",
      "mcp__plugin_figma_figma__upload_assets"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(python3 .claude/orch.py accept-review*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/orch.py\" hook format",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/orch.py\" hook guard-bash",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/orch.py\" hook guard-agent",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/orch.py\" hook require-commit",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
