{
  "name": "portfolio-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_LOGIN": "dinethde",
    "SITE_URL": "https://example.com"
  },
  "containers": [
    {
      "class_name": "PortfolioContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PORTFOLIO", "class_name": "PortfolioContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PortfolioContainer"] }]
}
